{
  "info": {
    "_postman_id": "a1b2c3d4-5e6f-47a8-9b10-service-vendor-catalog",
    "name": "6amMart - Service Module - Vendor App Catalog",
    "description": "Vendor (provider) app catalog APIs for the Service module.\n\nAuth: Bearer token + `vendorType: owner|employee` header (middleware `vendor.api`). The module is resolved from the token's store and can be overridden with the `moduleId` header. Every endpoint is scoped to the vendor's own store.\n\nCategories, sub-categories and store categories are COMMON vendor-app features served by the core endpoints (folder \"Common (core)\") and are not duplicated per-module.\n\nSet the collection variables `base_url`, `core_base`, `vendor_token` and `module_id` in your environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/api/v1",
      "type": "string"
    },
    {
      "key": "core_base",
      "value": "http://localhost/api/v1",
      "type": "string"
    },
    {
      "key": "vendor_token",
      "value": "PASTE_VENDOR_AUTH_TOKEN",
      "type": "string"
    },
    {
      "key": "vendor_type",
      "value": "owner",
      "type": "string"
    },
    {
      "key": "module_id",
      "value": "13",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{vendor_token}}",
        "type": "string"
      }
    ]
  },
